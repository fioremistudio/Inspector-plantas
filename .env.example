# Clave de la API de Anthropic (obligatoria para el análisis real con IA).
# Consíguela en https://console.anthropic.com -> "API Keys".
# Si la dejas vacía, la app funciona en "modo demostración" con diagnósticos de ejemplo.
ANTHROPIC_API_KEY=

# Modelo de IA a usar (opcional).
ANTHROPIC_MODEL=claude-opus-5-5

# Puerto del servidor (opcional).
PORT=3000

# Carpeta donde se guardan la base de datos y las fotos (opcional).
DATA_DIR=./data

# Máximo de análisis por usuario y día (los administradores no tienen límite). 0 = sin límite.
DAILY_DIAGNOSIS_LIMIT=20

# Pon "true" si sirves la app con HTTPS (recomendado en producción).
COOKIE_SECURE=false
